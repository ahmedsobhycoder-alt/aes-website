NEXT_PUBLIC_SITE_URL=https://aes-designstudio.com
PORT=3000

# Which deployment this build is for: "production" or "staging".
# Defaults to production when unset, so a correct production build needs no
# config. STAGING MUST SET THIS to staging — it switches the whole site to
# noindex/nofollow and makes robots.txt a blanket disallow.
# Read at BUILD time. Setting it only at runtime does nothing.
# See docs/STAGING_DEINDEXING.md
NEXT_PUBLIC_SITE_ENV=production

# Search-console verification. Leave blank and no meta tag is emitted at all.
# Prefer DNS verification; these are the fallback. Read at BUILD time.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Contact form delivery (Web3Forms).
#
# Get the key at https://web3forms.com — enter contact@aes-designstudio.com and
# it is emailed to you; no account needed. Then lock it to aes-designstudio.com
# in their dashboard so it cannot be used from another site.
#
# This is a publishable key: NEXT_PUBLIC_ means it is compiled into the browser
# bundle, which is how a static site can submit at all. It only identifies the
# destination inbox — it grants no read access to anything.
#
# WARNING: it is read at BUILD time, not run time. Set it before `npm run build`
# or the deployed form will fail with "unconfigured" and silently drop enquiries.
NEXT_PUBLIC_WEB3FORMS_KEY=981fb157-f5d5-42e5-9921-04b32a174479
